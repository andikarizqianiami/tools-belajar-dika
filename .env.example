# AI Provider Configuration
# Pilih salah satu atau lebih provider AI
# Uncomment provider yang ingin digunakan

# OpenAI (GPT-3.5/GPT-4)
# OPENAI_API_KEY=your_openai_api_key_here
# AI_PROVIDER=openai

# Groq (Llama 3, Mixtral) - GRATIS & CEPAT!
# GROQ_API_KEY=your_groq_api_key_here
# AI_PROVIDER=groq

# Google Gemini (Gemini Pro) - GRATIS untuk quota tertentu
# GEMINI_API_KEY=your_gemini_api_key_here
# AI_PROVIDER=gemini

# Default provider jika tidak diset
AI_PROVIDER=groq

# Model yang digunakan (verified available models)
# AI_MODEL=openai/gpt-oss-120b
# Alternatif: qwen/qwen3.8-27b, openai/gpt-oss-20b, groq/compound
